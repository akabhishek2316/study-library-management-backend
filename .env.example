PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/study-library
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# India = 330 (UTC+5:30). Used to decide what "today" means.
TZ_OFFSET_MINUTES=330
# Used by `npm run seed` to create the first owner account
OWNER_NAME=Library Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMe123

# --- Phase 2: payments ---
LIBRARY_NAME=Study Library
LIBRARY_ADDRESS=
# Razorpay (leave empty to disable online payments; cash/UPI entry by staff still works)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Phase 3: attendance ---
# QR/code changes this often (seconds). Shorter = harder to share a photo of the QR.
QR_ROTATE_SECONDS=60
# Visits still open after this time are checked out automatically (24h, library timezone)
LIBRARY_CLOSE_TIME=22:00
# Optional: only allow check-in near the library (needs HTTPS on the student's phone). Leave empty to turn off.
LIBRARY_LAT=
LIBRARY_LNG=
GEOFENCE_METERS=150
# Optional: separate secret for the QR codes (defaults to JWT_SECRET)
ATTENDANCE_SECRET=

# --- Phase 4: notices, reminders, email ---
# Email is optional. Leave SMTP_HOST empty and everything still works in-app.
# Gmail example: smtp.gmail.com / 587 / your address / an App Password (not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Plan-ending reminders go out this many days before the end date (0 = on the last day)
REMIND_DAYS=7,3,1,0
# Daily reminder time (cron) and its timezone
REMINDER_CRON=0 9 * * *
TIMEZONE=Asia/Kolkata
